# Copy to .env (git-ignored). The CLI loads it automatically.

# LLM — required for real generation (set llm.model in config/local.yaml)
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Textbook source database (hvr lectures --source db, hvr source export)
# TEXTBOOK_DB_URL=mysql://user:password@localhost:3307/tutorai

# TTS — only the provider selected in config (tts.provider) is needed
SARVAM_API_KEY=
# GOOGLE_TTS_API_KEY=
# GOOGLE_ACCESS_TOKEN=
# ELEVENLABS_API_KEY=

# Optional tool overrides
# HVR_CHROME=
# HVR_FFMPEG=
# HVR_FFPROBE=
