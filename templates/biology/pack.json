{
  "name": "Biology",
  "subjects": ["Biology", "Science"],
  "variants": [],
  "types": {
    "chapter_index":      { "max": 1 },
    "definition":         { "max": 5 },
    "characteristics":    { "max": 3 },
    "comparison":         { "max": 2 },
    "labeled_diagram":    { "max": 4 },
    "image_points":       { "max": 3 },
    "mechanism":          { "max": 3 },
    "solved_example":     { "max": 1 },
    "descriptive_answer": { "max": 2 },
    "mcq":                { "min": 2, "max": 5 },
    "assertion_reason":   { "max": 1 },
    "misconception":      { "max": 1 },
    "quick_revision":     { "max": 1 }
  },
  "questionTypes": ["mcq", "assertion_reason", "descriptive_answer", "solved_example"],
  "flow": {
    "firstLecture": { "startsWith": ["chapter_index"] },
    "otherLectures": { "notAt": { "chapter_index": "any" } },
    "everyLecture": { "endsWithAnyOf": ["mcq", "assertion_reason", "descriptive_answer"], "includes": ["quick_revision"] },
    "lastLecture": { "includes": ["quick_revision"], "minTrailingQuestions": 3 },
    "maxConsecutiveSameType": 2,
    "questionAfterDefinitions": 3
  },
  "fallbacks": {
    "labeled_diagram": "characteristics",
    "image_points": "characteristics",
    "mechanism": "characteristics"
  }
}
