{
  "name": "Commerce",
  "subjects": [
    "Accountancy",
    "Business Studies"
  ],
  "variants": [
    "accountancy",
    "business-studies"
  ],
  "types": {
    "intro": { "min": 1, "max": 1 },
    "hook": { "max": 1 },
    "concept_intro": { "max": 3 },
    "definition": { "max": 5 },
    "principle": { "max": 3 },
    "rule_cards": { "max": 2 },
    "timeline": { "max": 1 },
    "cause_effect": { "max": 2 },
    "process_flow": { "max": 2 },
    "labeled_diagram": { "max": 2 },
    "person": { "max": 1 },
    "comparison": { "max": 3 },
    "try_this": { "max": 1 },
    "journal_entry": { "max": 4 },
    "ledger": { "max": 3 },
    "trial_balance": { "max": 2 },
    "final_accounts": { "max": 2 },
    "balance_sheet": { "max": 2 },
    "adjustment": { "max": 3 },
    "practice_problem": { "max": 3 },
    "case_study": { "max": 2 },
    "misconception": { "max": 1 },
    "illustration": { "min": 1, "max": 2 },
    "mcq": { "min": 1, "max": 4 },
    "assertion_reason": { "max": 1 },
    "formula_sheet": { "max": 1 },
    "quick_revision": { "max": 1 }
  },
  "questionTypes": [
    "mcq",
    "assertion_reason",
    "case_study"
  ],
  "flow": {
    "firstLecture": {
      "opening": ["intro", "hook"]
    },
    "otherLectures": {
      "notAt": { "hook": "any" }
    },
    "everyLecture": {
      "opening": ["intro"],
      "endsWithAnyOf": ["mcq", "assertion_reason", "case_study"],
      "includesAnyOf": ["quick_revision", "formula_sheet"]
    },
    "lastLecture": {
      "minTrailingQuestions": 2
    },
    "maxConsecutiveSameType": 2,
    "questionAfterDefinitions": 3,
    "mustPrecede": {
      "practice_problem": ["journal_entry", "ledger", "trial_balance", "final_accounts", "balance_sheet", "adjustment"]
    }
  },
  "variantRules": {
    "business-studies": {
      "note": "Business Studies has no bookkeeping: the accounting formats are switched off and the case study carries the practice",
      "types": {
        "journal_entry": { "max": 0 },
        "ledger": { "max": 0 },
        "trial_balance": { "max": 0 },
        "final_accounts": { "max": 0 },
        "balance_sheet": { "max": 0 },
        "adjustment": { "max": 0 },
        "practice_problem": { "max": 0 },
        "formula_sheet": { "max": 0 },
        "rule_cards": { "max": 3 },
        "principle": { "max": 4 },
        "person": { "max": 2 },
        "case_study": { "max": 3 }
      },
      "flow": {
        "everyLecture": {
          "opening": ["intro"],
          "endsWithAnyOf": ["mcq", "assertion_reason", "case_study"],
          "includesAnyOf": ["quick_revision"]
        }
      }
    }
  },
  "fallbacks": {
    "labeled_diagram": "concept_intro"
  },
  "images": {
    "minUsed": 1,
    "note": "lectures with usable figures must show at least this many; unfilled image slots are auto-filled by description match"
  }
}
