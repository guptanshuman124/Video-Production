{
  "name": "Physics",
  "subjects": ["Physics", "Science"],
  "variants": [],
  "types": {
    "chapter_index":      { "max": 1 },
    "definition":         { "max": 5 },
    "characteristics":    { "max": 3 },
    "comparison":         { "max": 2 },
    "labeled_diagram":    { "max": 3 },
    "image_points":       { "max": 3 },
    "mechanism":          { "max": 2 },
    "derivation":         { "max": 2 },
